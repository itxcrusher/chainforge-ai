# ChainForge AI — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.

# AI
OPENAI_API_KEY=sk-proj-your-key-here

# WireFluid Network (server-side)
WIREFLUID_RPC_URL=https://evm.wirefluid.com
WIREFLUID_CHAIN_ID=92533

# Deployer wallet — used by Hardhat scripts only
PRIVATE_KEY=your-deployer-private-key-hex-no-0x-prefix

# Relayer wallet — used by gas-sponsored interaction route (Phase 2)
RELAYER_PRIVATE_KEY=your-relayer-private-key-hex-no-0x-prefix

# WireFluid Network (client-side / NEXT_PUBLIC_)
NEXT_PUBLIC_WIREFLUID_CHAIN_ID=92533
NEXT_PUBLIC_WIREFLUID_RPC_URL=https://evm.wirefluid.com
NEXT_PUBLIC_EXPLORER_URL=https://wirefluidscan.com
NEXT_PUBLIC_APP_URL=

# Contract addresses — fill after deployment
FACTORY_ADDRESS=
PREDICTION_IMPLEMENTATION_ADDRESS=

# Upstash Redis — Phase 2 only, leave blank for Phase 1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
