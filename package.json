{
  "name": "chainforge-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "deploy:wirefluid": "hardhat run scripts/deploy.ts --network wirefluid",
    "test:rpc": "ts-node --project tsconfig.scripts.json scripts/test-rpc.ts",
    "test:agents": "ts-node --project tsconfig.scripts.json scripts/test-agents.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.37.0",
    "next": "14.2.29",
    "openai": "^4",
    "react": "^18",
    "react-dom": "^18",
    "viem": "^2",
    "wagmi": "^2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5",
    "@openzeppelin/contracts": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "dotenv": "^16",
    "hardhat": "^2.22",
    "postcss": "^8",
    "tailwindcss": "^3",
    "ts-node": "^10",
    "typescript": "^5"
  }
}
